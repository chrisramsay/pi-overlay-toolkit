#!/bin/bash
# /usr/local/sbin/overlay-off
#
# Disables OverlayFS (root filesystem becomes writable again) and reboots.
# Run this before making any changes you want to survive a reboot.

set -e

# Ground-truth check via /proc/mounts — raspi-config's own get_overlay_now
# getter reports its answer as printed text, not via exit code, so testing
# its exit status directly is unreliable. Match on root's filesystem TYPE
# (3rd field), not the mount source name: some builds (e.g. trixie) use
# the Debian "overlayroot" package, whose source device is named
# "overlayroot" rather than "overlay".
ROOT_FSTYPE=$(awk '$2 == "/" { print $3; exit }' /proc/mounts)
if [ "$ROOT_FSTYPE" != "overlay" ]; then
    echo "Overlay is already OFF — root filesystem is already writable."
    exit 0
fi

echo "Disabling OverlayFS. The Pi will reboot in 5 seconds..."
echo "After reboot, the root filesystem will be WRITABLE."
sudo raspi-config nonint disable_overlayfs

# See overlay-on for why this matters: flush before reboot so a hung boot
# and unclean power-off can't silently lose recent writes.
sync

sleep 5
sudo systemctl reboot
