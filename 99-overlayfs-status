#!/bin/bash
# /etc/update-motd.d/99-overlayfs-status
#
# Dynamic MOTD fragment, run by pam_motd on every SSH login. Shows the live
# overlay state loudly, plus any change that's pending at next reboot, so
# you don't edit something that will vanish (or forget to re-protect the
# SD card).
#
# Must never fail noisily or block a login: if the helper library is
# missing, print nothing.

LIB=/usr/local/lib/pi-overlay-toolkit/overlay-common.sh
[ -r "$LIB" ] || exit 0
# shellcheck source=overlay-common.sh
. "$LIB"

HOST=$(hostname)
LIVE=$(pot_live_word)
CONF=$(pot_configured_word)

if [ "$LIVE" = on ]; then
    cat <<EOF

  ##########################################################################
     !!  ${HOST}: OverlayFS is ON. Root filesystem is a RAM overlay  !!

     ANY change you make now (apt install, config edits, new files,
     logs outside tmpfs) will be LOST at the next reboot.

     To make a persistent change:
       overlay-off      # root becomes writable, reboots
       ...make and test your changes...
       overlay-on       # protection back on, reboots
  ##########################################################################
EOF
else
    cat <<EOF

  --------------------------------------------------------------------------
     ${HOST}: OverlayFS is OFF. Root is WRITABLE (changes persist to SD).
     Run 'overlay-on' when you're done making changes.
  --------------------------------------------------------------------------
EOF
fi

if [ "$CONF" != unknown ] && [ "$CONF" != "$LIVE" ]; then
    cat <<EOF
     PENDING: overlay will be ${CONF^^} after the next reboot.
     (Run 'overlay-${LIVE}' to cancel that, or reboot to apply it.)
EOF
fi
echo
